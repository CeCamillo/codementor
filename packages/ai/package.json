{
  "name": "@codementor/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./concepts": {
      "types": "./dist/concepts/index.d.ts",
      "import": "./dist/concepts/index.js"
    },
    "./playbooks": {
      "types": "./dist/playbooks/index.d.ts",
      "import": "./dist/playbooks/index.js"
    }
  },
  "scripts": {
    "build": "tsc && bun run copy-assets",
    "copy-assets": "cp -r src/concepts dist/ && cp -r src/playbooks dist/",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@codementor/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
