{
  "name": "@codementor/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codementor": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "dev": "bun run --watch ./src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test || true"
  },
  "dependencies": {
    "@codementor/shared": "workspace:*",
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
